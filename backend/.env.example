# ==========================================
# SkillRoute - Environment Variables Template
# ==========================================
# Rename this file to .env and fill in the actual values.
# NEVER commit your real .env file to version control.

# --- Security ---
# Secret key for signing JWT tokens. Use a strong random string in production.
SECRET_KEY=supersecretkey_change_in_production

# --- Database ---
# Connection string for the PostgreSQL database (e.g., Neon serverless DB)
DATABASE_URL=postgresql://user:password@localhost:5432/aln_db

# --- External APIs ---
# Groq API Key (Used for Llama 3 inference in AI Coach and Search Query generation)
# Get one at: https://console.groq.com/
GROQ_API_KEY=your_groq_api_key_here

# YouTube Data API v3 Key (Used for fetching video recommendations)
# Get one at: https://console.cloud.google.com/
YOUTUBE_API_KEY=your_youtube_api_key_here

# --- Optional AI Tunables ---
# (Usually safe to leave as default, but can be overridden)
# YOUTUBE_MIN_CACHE_RESULTS=5
# YOUTUBE_CACHE_TTL_HOURS=168
# YOUTUBE_SEARCH_MAX_RESULTS=5
# YOUTUBE_MAX_SEARCH_QUERIES=3
# GROQ_SEARCH_MODEL=openai/gpt-oss-20b
# EMBEDDING_MODEL=all-MiniLM-L6-v2
# SKILL_SIMILARITY_THRESHOLD=0.33
# SKILL_SIMILARITY_TOP_K=5
# AMBIGUITY_MARGIN=0.03
